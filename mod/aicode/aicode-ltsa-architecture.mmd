flowchart LR
  %% LTSA Architecture for Moodle mod_aicode

  LE([Learner Entity<br/>Mahasiswa/Peserta Didik])
  D([Delivery<br/>view.php + renderer.php + amd/editor.js])
  E([Evaluation<br/>mod_aicode_run_code])
  C([Coach<br/>mod_aicode_analyze_code])
  LR[(Learning Resources<br/>aicode + aicode_materials)]
  LRec[(Learner Record<br/>aicode_attempts)]

  EX[[Executor Service<br/>POST /run]]
  AI[[Moodle AI Engine<br/>core_ai manager]]
  Cache[(Prompt Cache<br/>aicode_cache)]
  Hint[[Hint Tracker<br/>mod_aicode_record_hint]]
  TR[[Teacher Review<br/>mod_aicode_send_to_teacher]]
  T[Teacher]

  LE -->|interaksi belajar| D
  D -->|umpan balik UI| LE

  D -->|Run Code| E
  E -->|hasil run (stdout/stderr)| D
  E -->|simpan hasil percobaan| LRec

  E -->|eksekusi sandbox| EX
  EX -->|result JSON| E

  D -->|minta hint/analisis| C
  C -->|feedback diagnosis + saran| D

  C -->|ambil konteks soal| LR
  LR -->|materi/konfigurasi| C

  C -->|riwayat percobaan| LRec
  LRec -->|attempt history| C

  C -->|permintaan AI| AI
  AI -->|feedback terstruktur| C

  C -->|cache read/write| Cache
  Cache -->|cached feedback| C

  D -->|record hint usage| Hint
  Hint -->|update used_hints_json| LRec

  D -->|kirim ke guru| TR
  TR -->|teacher review requested| LRec
  TR -.opsional notifikasi.-> T

  classDef core fill:#eef6ff,stroke:#1e3a8a,stroke-width:1.5px,color:#111827;
  classDef store fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#111827;
  classDef ext fill:#fff7ed,stroke:#9a3412,stroke-dasharray: 5 3,color:#111827;

  class LE,D,E,C core;
  class LR,LRec,Cache store;
  class EX,AI,Hint,TR ext;
