<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/aicode/db" VERSION="2026042920" COMMENT="XMLDB file for Moodle mod/aicode"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="aicode" COMMENT="Stores programming problems for AICode activities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="language" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="javascript" SEQUENCE="false"/>
        <FIELD NAME="testcases" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON array of test cases"/>
        <FIELD NAME="startercode" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="htmltemplate" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="csstemplate" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="allow_training" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="training" SEQUENCE="false" COMMENT="Activity mode: training or exam"/>
        <FIELD NAME="aiprompttemplate" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional per-activity AI prompt template override"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="language" UNIQUE="false" FIELDS="language"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aicode_attempts" COMMENT="Student code submission attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="problemid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Nullable for anonymized attempts"/>
        <FIELD NAME="code_hash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="is_anonymous" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="result_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Short execution result"/>
        <FIELD NAME="used_hints_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Array of hint usage timestamps"/>
        <FIELD NAME="ai_feedback_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="AI analysis result"/>
        <FIELD NAME="security_flags" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON security check result (risk_level, violations)"/>
        <FIELD NAME="ai_requested_at" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="Unix timestamp when student clicked AI Hint; NULL means no AI request on this attempt"/>
        <FIELD NAME="teacher_review_requested" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 when this attempt was submitted to teacher for review (exam mode)"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="problemid" TYPE="foreign" FIELDS="problemid" REFTABLE="aicode" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="code_hash" UNIQUE="false" FIELDS="code_hash"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
        <INDEX NAME="userid_ai_requested_at" UNIQUE="false" FIELDS="userid, ai_requested_at"/>
        <INDEX NAME="problemid_userid_teacher_review" UNIQUE="false" FIELDS="problemid, userid, teacher_review_requested"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aicode_cache" COMMENT="Caches AI responses for repeated queries">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="payload_hash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="ai_response_json" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="payload_hash" UNIQUE="true" FIELDS="payload_hash"/>
        <INDEX NAME="timecreated" UNIQUE="false" FIELDS="timecreated"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aicode_teacher_overrides" COMMENT="Teacher corrections to AI feedback">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="teacherid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="corrected_feedback_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Structured correction: notes, rating, corrected_diagnosis, corrected_hints, corrected_suggested_fix, use_as_example"/>
        <FIELD NAME="feedback_rating" TYPE="int" LENGTH="1" NOTNULL="false" SEQUENCE="false" COMMENT="Teacher rating of original AI feedback quality, 1-5"/>
        <FIELD NAME="use_as_example" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Whether to inject this correction as a few-shot example into future AI prompts"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="attemptid" TYPE="foreign" FIELDS="attemptid" REFTABLE="aicode_attempts" REFFIELDS="id"/>
        <KEY NAME="teacherid" TYPE="foreign" FIELDS="teacherid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptid" UNIQUE="true" FIELDS="attemptid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="aicode_activity_log" COMMENT="Log metadata aktivitas (tanpa kode sumber)">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="id_kursus" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID kursus Moodle"/>
        <FIELD NAME="id_modul" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID course module"/>
        <FIELD NAME="id_aktivitas_aicode" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Baris aicode.id"/>
        <FIELD NAME="id_pengguna" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="kode_kejadian" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false" COMMENT="Jenis peristiwa (kode internal)"/>
        <FIELD NAME="metadata_json" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Metadata kecil JSON (tanpa kode)"/>
        <FIELD NAME="nama_lengkap" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Snapshot nama siswa"/>
        <FIELD NAME="mode_aktivitas" TYPE="char" LENGTH="16" NOTNULL="true" DEFAULT="training" SEQUENCE="false" COMMENT="training atau exam"/>
        <FIELD NAME="jumlah_ai_hint" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Kumulatif permintaan AI Hint"/>
        <FIELD NAME="jumlah_run" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Kumulatif run"/>
        <FIELD NAME="jumlah_kirim_guru" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Kumulatif kirim ke guru"/>
        <FIELD NAME="nilai_snapshot" TYPE="number" LENGTH="12" NOTNULL="false" SEQUENCE="false" DECIMALS="5" COMMENT="Nilai buku nilai 0-100 jika ada"/>
        <FIELD NAME="waktu_dicatat" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_id_kursus" TYPE="foreign" FIELDS="id_kursus" REFTABLE="course" REFFIELDS="id"/>
        <KEY NAME="fk_id_modul" TYPE="foreign" FIELDS="id_modul" REFTABLE="course_modules" REFFIELDS="id"/>
        <KEY NAME="fk_id_aktivitas" TYPE="foreign" FIELDS="id_aktivitas_aicode" REFTABLE="aicode" REFFIELDS="id"/>
        <KEY NAME="fk_id_pengguna" TYPE="foreign" FIELDS="id_pengguna" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_waktu_dicatat" UNIQUE="false" FIELDS="waktu_dicatat"/>
        <INDEX NAME="idx_pengguna_waktu" UNIQUE="false" FIELDS="id_pengguna, waktu_dicatat"/>
        <INDEX NAME="idx_aktivitas_waktu" UNIQUE="false" FIELDS="id_aktivitas_aicode, waktu_dicatat"/>
        <INDEX NAME="idx_kode_waktu" UNIQUE="false" FIELDS="kode_kejadian, waktu_dicatat"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
