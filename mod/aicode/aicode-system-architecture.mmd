flowchart TB
  %% System Architecture for Moodle mod_aicode

  subgraph Actors["Aktor"]
    S[Student]
    T[Teacher]
    A[Admin]
  end

  subgraph Frontend["Browser Frontend"]
    V["Activity Page<br/>view.php + renderer.php"]
    UI["Editor UI<br/>amd/src/editor.js"]
    AJAX["Moodle AJAX Client<br/>core/ajax"]
    PRE["Preview + History<br/>iframe + sessionStorage"]
  end

  subgraph Backend["Moodle Server (mod_aicode)"]
    SEC{{"Security Gate<br/>require_login + context + capability + sesskey"}}
    REG["WS Registry<br/>db/services.php"]

    RUN["Endpoint: mod_aicode_run_code"]
    AN["Endpoint: mod_aicode_analyze_code"]
    RH["Endpoint: mod_aicode_record_hint"]
    ST["Endpoint: mod_aicode_send_to_teacher"]

    CFG["Plugin Settings<br/>settings.php"]
    AIM["Moodle AI Manager<br/>core_ai generate_text"]
    EV["Event + Privacy + Gradebook<br/>course_module_viewed + provider + grade_update"]
  end

  subgraph Data["Moodle Database"]
    D1[(aicode)]
    D2[(aicode_attempts)]
    D3[(aicode_cache)]
    D4[(aicode_teacher_overrides)]
    D5[(aicode_materials)]
  end

  subgraph External["External Services"]
    EX["Executor Microservice<br/>POST /run"]
    AIP["AI Provider (via Moodle AI)<br/>contoh: Ollama"]
  end

  S -->|akses aktivitas| V
  T -->|monitoring/feedback| V
  A -->|konfigurasi plugin| CFG

  V --> UI
  UI --> PRE
  UI -->|Run / Hint / Submit| AJAX
  AJAX --> SEC

  REG --> RUN
  REG --> AN
  REG --> RH
  REG --> ST

  SEC --> RUN
  SEC --> AN
  SEC --> RH
  SEC --> ST

  V -->|load soal + template| D1
  D1 -->|problem payload| V

  RUN -->|baca testcases| D1
  RUN -->|POST code+testcase| EX
  EX -->|stdout/stderr/exitCode| RUN
  RUN -->|insert attempt| D2
  RUN -->|execution result| AJAX

  AN -->|rate limit & riwayat| D2
  AN -->|cache lookup/store| D3
  AN -->|prompt AI| AIM
  AIM -->|request model| AIP
  AIP -->|generated feedback| AIM
  AIM -->|feedback JSON| AN
  AN -->|feedback ke frontend| AJAX

  RH -->|update used_hints_json| D2
  RH -->|acknowledge| AJAX

  ST -->|teacher review request| D2
  ST -->|acknowledge| AJAX
  ST -.opsional notifikasi.-> T

  EV --> D2
  EV --> D4
  EV --> D5

  classDef actor fill:#ffffff,stroke:#1f2937,color:#111827;
  classDef front fill:#eef6ff,stroke:#1d4ed8,color:#111827;
  classDef back fill:#f0fdf4,stroke:#166534,color:#111827;
  classDef data fill:#f8fafc,stroke:#475569,color:#111827;
  classDef ext fill:#fff7ed,stroke:#9a3412,color:#111827;

  class S,T,A actor;
  class V,UI,AJAX,PRE front;
  class SEC,REG,RUN,AN,RH,ST,CFG,AIM,EV back;
  class D1,D2,D3,D4,D5 data;
  class EX,AIP ext;
