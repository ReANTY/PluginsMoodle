flowchart LR
  %% LTSA Variant: Evaluation focuses on learning performance assessment

  LE([Learner Entity<br/>Mahasiswa/Peserta Didik])
  D([Delivery<br/>UI AICode + editor + preview])
  E([Evaluation<br/>Asesmen performa belajar])
  C([Coach<br/>Strategi bantuan adaptif])
  LR[(Learning Resources<br/>soal, rubrik, materi)]
  LRec[(Learner Record<br/>attempt, hint, progres, skor)]

  X[[Execution Engine<br/>Sandbox test runner]]
  AI[[AI Pedagogical Assistant]]
  Cache[(Prompt/Feedback Cache)]
  Hint[[Hint Tracker]]
  TR[[Teacher Review]]
  T[Teacher]

  LE -->|interaksi belajar| D
  D -->|umpan balik antarmuka| LE

  D -->|run code & testcase| X
  X -->|raw result evidence| LRec

  D -->|request hint| Hint
  Hint -->|hint usage log| LRec

  D -->|kirim ke guru| TR
  TR -->|review request record| LRec
  TR -.opsional notifikasi.-> T

  LRec -->|riwayat performa| E
  LR -->|rubrik & target kompetensi| E
  E -->|skor, indikator, mastery| LRec
  E -->|ringkasan capaian| D
  E -->|profil performa belajar| C

  C -->|feedback adaptif| D
  C -->|prompt pedagogik| AI
  AI -->|diagnosis + saran belajar| C

  C -->|cache read/write| Cache
  Cache -->|cached insight| C
  C -->|rekomendasi materi| LR

  classDef core fill:#eef6ff,stroke:#1e3a8a,stroke-width:1.5px,color:#111827;
  classDef store fill:#f8fafc,stroke:#475569,stroke-width:1.5px,color:#111827;
  classDef ext fill:#fff7ed,stroke:#9a3412,stroke-dasharray: 5 3,color:#111827;

  class LE,D,E,C core;
  class LR,LRec,Cache store;
  class X,AI,Hint,TR ext;
