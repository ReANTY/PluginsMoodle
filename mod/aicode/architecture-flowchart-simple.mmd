flowchart LR
  subgraph Actors["Aktor"]
    Student["Student"]
    Teacher["Teacher"]
    Admin["Admin"]
  end

  subgraph Frontend["Browser (Frontend)"]
    Page["Activity Page<br/>view.php + renderer.php"]
    UI["Editor UI<br/>Run | Hint | Submit | History"]
    Preview["Preview + Error Panel"]
    History["Riwayat lokal<br/>sessionStorage"]
  end

  subgraph Backend["Moodle Server (mod_aicode)"]
    Gate{{"Access Guard<br/>context + capability + sesskey"}}
    Settings["Admin Settings<br/>executor_url, prompt template,<br/>confidence_threshold, cache_ttl, max_calls_per_day"]

    Run["mod_aicode_run_code"]
    Analyze["mod_aicode_analyze_code"]
    RecordHint["mod_aicode_record_hint"]
    SendTeacher["mod_aicode_send_to_teacher"]

    PromptResolver["Prompt Resolver<br/>activity -> global -> default"]
    AIMgr["Moodle AI Manager<br/>core_ai + generate_text"]
  end

  subgraph Data["Moodle Database"]
    TblAicode[("aicode")]
    TblAttempts[("aicode_attempts")]
    TblCache[("aicode_cache")]
  end

  subgraph External["External Services"]
    Executor["Executor Service<br/>POST /run"]
    AIProvider["AI Provider via Moodle AI"]
  end

  Student -->|"Akses aktivitas"| Page
  Teacher -->|"Akses aktivitas"| Page
  Admin -->|"Konfigurasi plugin"| Settings

  Page -->|"Load problem"| TblAicode
  Page --> UI
  UI --> Preview
  UI --> History

  UI -->|"Run"| Run
  Run --> Gate
  Run -->|"Read testcase"| TblAicode
  Run -->|"Execute payload"| Executor
  Executor -->|"Result JSON"| Run
  Run -->|"Insert attempt"| TblAttempts
  Run -->|"Execution result"| UI

  Run -.->|"Jika gagal"| Analyze
  UI -->|"Hint"| Analyze
  Analyze --> Gate
  Analyze -->|"Rate limit check"| TblAttempts
  Analyze -->|"Cache lookup/store"| TblCache
  Analyze --> PromptResolver
  PromptResolver --> AIMgr
  AIMgr -->|"generate_text"| AIProvider
  AIProvider --> AIMgr
  AIMgr --> Analyze
  Analyze -->|"AI feedback"| UI

  UI -->|"Hint terpakai"| RecordHint
  RecordHint --> Gate
  RecordHint -->|"Update used_hints_json"| TblAttempts

  UI -->|"Submit"| SendTeacher
  SendTeacher --> Gate
  SendTeacher -->|"Insert teacher_review_requested"| TblAttempts
  SendTeacher -.->|"TODO notification"| Teacher

