# AICode Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# ANALYZER SERVICE (Port 3002)
# =============================================================================

# Google Gemini API Key (REQUIRED)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini API URL (optional, uses default if not set)
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro:generateContent

# AI Confidence Threshold (0.0-1.0, default: 0.6)
# Feedback below this confidence will use rule-based fallback
CONFIDENCE_THRESHOLD=0.6


# =============================================================================
# EXECUTOR SERVICE (Port 3001)
# =============================================================================

# Execution mode: 'dev' (vm2) or 'prod' (Docker)
# - dev: Faster, uses vm2 isolation (good for local development)
# - prod: More secure, uses Docker containers (recommended for production)
EXECUTOR_MODE=dev

# Maximum execution time in milliseconds (default: 2000)
EXECUTION_TIMEOUT=2000


# =============================================================================
# OPTIONAL: Override default ports
# =============================================================================

# Uncomment to change default ports
# EXECUTOR_PORT=3001
# ANALYZER_PORT=3002
